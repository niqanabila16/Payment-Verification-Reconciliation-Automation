# ============================================================================
# Contoh file .env -- SALIN jadi ".env" (tanpa akhiran .example) lalu isi
# nilai asli. JANGAN commit file ".env" yang sudah berisi nilai asli ke git.
# ============================================================================

# --- Database (cocok dengan config/docker-compose.yml) ---
POSTGRES_USER=reconciliation_user
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=reconciliation_db
DATABASE_URL=postgresql://reconciliation_user:changeme_local_only@localhost:5432/reconciliation_db

# --- Redis (job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Folder aman untuk XLSX bank (Bagian 14 Technical Design Document) ---
BANK_INCOMING_FOLDER=./data/01_incoming_bank
BANK_PROCESSING_FOLDER=./data/02_processing
BANK_PROCESSED_FOLDER=./data/03_processed
BANK_EXCEPTION_FOLDER=./data/04_exception
BANK_ARCHIVE_FOLDER=./data/05_archive

# --- OCR Provider (BARU DIISI MULAI PHASE 2, lihat ADR-0007) ---
# OCR_PROVIDER=AZURE
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Microsoft Graph API (untuk polling SharePoint List/Excel, lihat ADR-0008) ---
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_SHAREPOINT_SITE_ID=
# MS_SHAREPOINT_LIST_ID=

# --- Microsoft Teams webhook (notifikasi internal, lihat ADR-0006) ---
# TEAMS_WEBHOOK_URL=

# --- WhatsApp Business API (BARU DIISI MULAI PHASE 2, lihat ADR-0007) ---
# WHATSAPP_BUSINESS_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- App secrets ---
APP_SECRET_KEY=ganti_dengan_string_acak_panjang
ENVIRONMENT=development
