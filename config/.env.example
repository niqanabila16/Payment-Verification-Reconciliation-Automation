# ============================================================================
# Example .env file -- COPY this to ".env" (without the .example suffix)
# then fill in real values. DO NOT commit a ".env" file with real values to git.
# ============================================================================

# --- Database (matches config/docker-compose.yml) ---
POSTGRES_USER=reconciliation_user
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=reconciliation_db
DATABASE_URL=postgresql://reconciliation_user:changeme_local_only@localhost:5432/reconciliation_db

# --- Redis (job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- Secure folder for bank XLSX files (Technical Design Document Section 14) ---
BANK_INCOMING_FOLDER=./data/01_incoming_bank
BANK_PROCESSING_FOLDER=./data/02_processing
BANK_PROCESSED_FOLDER=./data/03_processed
BANK_EXCEPTION_FOLDER=./data/04_exception
BANK_ARCHIVE_FOLDER=./data/05_archive

# --- OCR Provider (ONLY FILLED IN STARTING PHASE 2, see ADR-0007) ---
# OCR_PROVIDER=AZURE
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Microsoft Graph API (for polling the SharePoint List/Excel table, see ADR-0008) ---
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_SHAREPOINT_SITE_ID=
# MS_SHAREPOINT_LIST_ID=

# --- Microsoft Teams webhook (internal notifications, see ADR-0006) ---
# TEAMS_WEBHOOK_URL=

# --- WhatsApp Business API (ONLY FILLED IN STARTING PHASE 2, see ADR-0007) ---
# WHATSAPP_BUSINESS_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- App secrets ---
APP_SECRET_KEY=replace_with_a_long_random_string
ENVIRONMENT=development
