# Copy this file to ".env" and adjust the values. Never commit the real .env file.

# --- Core ---------------------------------------------------------------
# Generate a new key with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the site is served over HTTPS from another host name, e.g. https://recon.company.local
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------
# sqlite (default, zero setup) or postgres (matches database/schema DBML)
DB_ENGINE=sqlite
DB_NAME=payment_reconciliation
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Notifications ------------------------------------------------------
# Set to True to also send an e-mail digest to tellers after each reconciliation run.
NOTIFY_BY_EMAIL=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=reconciliation@company.local

# --- Business rules (see docs/REQUIREMENTS_TRACEABILITY.md) ---------------
MATCH_TYPO_MIN_SCORE=80
REFERENCE_MIN_LENGTH=6
REFERENCE_MAX_LENGTH=20
