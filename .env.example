# Copy this file to ".env" and adjust the values. Never commit the real .env file.

# --- Core ---------------------------------------------------------------
# Generate a new key with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the site is served over HTTPS from another host name, e.g. https://recon.company.local
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -----------------------------------------------------------
# sqlite (default, zero setup) or postgres (matches database/schema DBML)
DB_ENGINE=sqlite
DB_NAME=payment_reconciliation
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Notifications ------------------------------------------------------
# Set to True to also send an e-mail digest to tellers after each reconciliation run.
NOTIFY_BY_EMAIL=False
# Leave EMAIL_HOST empty = development: mail is only printed in the server window. Fill EMAIL_HOST to send real mail.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=reconciliation@company.local

# --- Forgot password (e-mailed link) --------------------------------------
# With the console backend the link is printed in the server window. For real e-mail use
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and fill in the EMAIL_* lines above.
# SITE_BASE_URL is the address users type in the browser; it is used to build the link inside the e-mail.
SITE_BASE_URL=http://127.0.0.1:8000
PASSWORD_RESET_MINUTES=60

# --- Business rules (see docs/REQUIREMENTS_TRACEABILITY.md) ---------------
NAME_WORD_MIN_SCORE=85
NAME_MATCH_MIN_WORDS=2
# Which single mismatch makes a receipt go to Review: name, amount, reference (comma separated). For now only amount.
REVIEW_REASONS=amount
# Bank statement data is deleted this many days after the upload
BANK_DATA_RETENTION_DAYS=31
REFERENCE_MIN_LENGTH=6
REFERENCE_MAX_LENGTH=20
